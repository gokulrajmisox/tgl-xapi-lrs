{
  "manifest_version": 3,
  "name": "TGL Learning Companion",
  "version": "0.1.0",
  "description": "Opt-in active-time tracking on TGL-approved learning domains. Never reads page content.",
  "permissions": ["tabs", "idle", "storage", "alarms"],
  "optional_host_permissions": ["https://*/*", "http://localhost:3000/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "TGL Learning Companion" }
}
