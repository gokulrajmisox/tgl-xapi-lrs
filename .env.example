# -----------------------------------------------------------------------------
# Touch Grass Later (TGL) - Environment Variables Configuration
# -----------------------------------------------------------------------------

# Site URL (for Auth redirects and absolute links)
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# -----------------------------------------------------------------------------
# Firebase Client Configuration (from Firebase Console -> Project Settings -> General -> Web App)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_FIRESTORE_DATABASE_ID=(default)
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_RECAPTCHA_SITE_KEY=

# -----------------------------------------------------------------------------
# Firebase Admin SDK / Server Configuration
# (from Firebase Console -> Project Settings -> Service accounts -> Generate new private key)
# -----------------------------------------------------------------------------
# Option A: Full JSON string in a single variable (recommended for Vercel)
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"your-project-id","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-...@your-project-id.iam.gserviceaccount.com"}'

# Option B: Individual split credentials (alternative to FIREBASE_SERVICE_ACCOUNT_JSON)
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Secret used to sign session cookies
FIREBASE_SESSION_SECRET=your-random-32-char-secret-string

# -----------------------------------------------------------------------------
# Razorpay Standard Web Checkout (Test Mode)
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_yourKeyId
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_yourKeyId
RAZORPAY_KEY_SECRET=yourRazorpaySecret
RAZORPAY_WEBHOOK_SECRET=yourWebhookSecret

# -----------------------------------------------------------------------------
# Email & Testmail Provider Configuration
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM="Touch Grass Later <no-reply@touchgrasslater.org>"
EMAIL_TEST_MODE=true

# Testmail namespace testing
TESTMAIL_NAMESPACE=humn4
TESTMAIL_APIKEY=yourTestmailApiKey
TESTMAIL_ENABLED=true
